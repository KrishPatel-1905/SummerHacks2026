{
  "name": "event-capsule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A shared, persistent event memory capsule.",
  "scripts": {
    "dev": "node --watch server.js",
    "dev:memory": "node --watch server/devMemory.js",
    "start": "node server.js",
    "video:music": "node video/generate-music.mjs",
    "video:render:voice": "remotion render video/index.jsx EventCapsuleVoiceover deliverables/event-capsule-voiceover.mp4 --public-dir=video/public --codec=h264 --crf=18",
    "video:render:captions": "remotion render video/index.jsx EventCapsuleCaptions deliverables/event-capsule-music-captions.mp4 --public-dir=video/public --codec=h264 --crf=18",
    "test": "node --test",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "mongoose": "^8.17.1",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.507",
    "mongodb-memory-server": "^10.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.507"
  }
}
