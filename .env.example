# Required: MongoDB connection string. The database name may be included here.
MONGODB_URI=mongodb://127.0.0.1:27017/event-capsule

# Optional server settings.
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
TRUST_PROXY=false
ANALYSIS_INTERVAL_MS=15000

# GridFS persists uploads in MongoDB Atlas and is the default.
UPLOAD_STORAGE=gridfs

# Used only when UPLOAD_STORAGE=local.
UPLOAD_DIR=./uploads
